-- ===================== LOOP: animasi + klik =====================
local hb
hb = RunService.Heartbeat:Connect(function(dt)
    local t = os.clock()
    outlineGradient.Rotation = (outlineGradient.Rotation + dt * 140) % 360
    titleGradient.Rotation   = (titleGradient.Rotation + dt * 90) % 360
    auroraGradient.Rotation  = (auroraGradient.Rotation + dt * 10) % 360
    circleGradient.Rotation  = (circleGradient.Rotation + dt * (state.running and 260 or 90)) % 360
    for _, s in ipairs(stars) do
        s.f.BackgroundTransparency = 0.5 + 0.4 * math.sin(t * s.sp + s.ph)
    end
    if state.minimized then
        minimizeBtn.Position = UDim2.new(1, -60, 0.5, -12 + math.sin(t * 3) * 2)
    end

    if state.running then
        acc += dt
        local interval = 1 / state.cps
        circle.BackgroundTransparency = 0.55
        if state.down then
            send(false, state.pendingMouse)
            state.down = false
        elseif acc >= interval then
            acc = math.min(acc - interval, interval)
            circle.BackgroundTransparency = 0.2
            clickTick()
        end
    end
end)

-- ===================== CLOSE: circle ikut hilang =====================
closeBtn.MouseButton1Click:Connect(function()
    state.running = false
    if state.down then send(false, state.pendingMouse) state.down = false end
    hb:Disconnect()
    dragConn:Disconnect()
    if camConn then camConn:Disconnect() end
    camSwap:Disconnect()
    local tw = TweenService:Create(main, T_FAST, {Size = UDim2.fromOffset(0, 0)})
    tw:Play()
    tw.Completed:Wait()
    gui:Destroy() -- circle ada di ScreenGui yang sama, ikut kehapus
end)

