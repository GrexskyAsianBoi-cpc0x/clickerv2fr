-- ===================== UI BUTTON DETECTION =====================
local canFire = (firesignal ~= nil) or (getconnections ~= nil)

local function fireSignal(sig)
    if firesignal then return pcall(firesignal, sig) end
    if getconnections then
        local ok, conns = pcall(getconnections, sig)
        if ok and type(conns) == "table" then
            for _, c in ipairs(conns) do pcall(function() c:Fire() end) end
            return true
        end
    end
    return false
end

local function isShown(obj)
    local o = obj
    while o and o ~= PlayerGui do
        if o:IsA("GuiObject") then
            if not o.Visible then return false end
        elseif o:IsA("ScreenGui") then
            if not o.Enabled then return false end
        end
        o = o.Parent
    end
    return o == PlayerGui
end

local function usable(btn)
    if not btn.Active then return false end
    local ok, inter = pcall(function() return btn.Interactable end)
    if ok and inter == false then return false end
    return true
end

-- titik circle (koordinat layar penuh) ada di dalam tombol?
local function contains(obj, pt)
    local sg = obj:FindFirstAncestorWhichIsA("ScreenGui")
    local off = (sg and not sg.IgnoreGuiInset) and GuiService:GetGuiInset() or Vector2.zero
    local p = obj.AbsolutePosition + off
    local s = obj.AbsoluteSize
    return pt.X >= p.X and pt.X <= p.X + s.X and pt.Y >= p.Y and pt.Y <= p.Y + s.Y
end

local function resolveButton()
    local pt = clampPos(targetPos)
    if cachedBtn then
        if cachedBtn:IsDescendantOf(PlayerGui) and usable(cachedBtn) and isShown(cachedBtn) and contains(cachedBtn, pt) then
            return cachedBtn
        end
        cachedBtn = nil
    end
    local now = os.clock()
    if now - scanAt < 0.25 then return nil end
    scanAt = now

    local best, bestScore
    for _, d in ipairs(PlayerGui:GetDescendants()) do
        if d:IsA("GuiButton") and not d:IsDescendantOf(gui) and usable(d) and isShown(d) and contains(d, pt) then
            local sg = d:FindFirstAncestorWhichIsA("ScreenGui")
            local score = (sg and sg.DisplayOrder or 0) * 100000 + d.ZIndex
            if not best or score >= bestScore then best, bestScore = d, score end
        end
    end
    cachedBtn = best
    return best
end

local function fireButton(btn)
    if not canFire then return false end
    local any = false
    for _, name in ipairs({"MouseButton1Down", "MouseButton1Up", "MouseButton1Click", "Activated"}) do
        local ok = fireSignal(btn[name])
        any = any or ok
    end
    return any
end

-- ===================== CLICK ENGINE =====================
local useTouch = (METHOD == "touch") or (METHOD == "auto" and UserInputService.TouchEnabled)

local function send(down, forceMouse)
    if not VIM then return end
    local p = clampPos(targetPos)
    pcall(function()
        if useTouch and not forceMouse then
            VIM:SendTouchEvent(TOUCH_ID, down and 0 or 2, p.X, p.Y)
        else
            VIM:SendMouseButtonEvent(p.X, p.Y, 0, down, game, 0)
        end
    end)
end

local function clickTick()
    local btn = resolveButton()
    dot.BackgroundColor3 = btn and WHITE or THEME.accent2
    if btn and fireButton(btn) then return end -- tombol UI: langsung di-trigger
    state.pendingMouse = (btn ~= nil)          -- ada tombol tapi gak bisa di-fire -> pakai mouse
    send(true, state.pendingMouse)
    state.down = true
end

local function setCps(n)
    n = math.clamp(math.floor(tonumber(n) or state.cps), MIN_CPS, MAX_CPS)
    state.cps = n
    cpsBox.Text = tostring(n)
end

local function setRunning(v)
    state.running = v
    acc = 0
    circle.Active = not v -- ON: klik tembus ke game, OFF: circle bisa digeser
    if not v and state.down then send(false, state.pendingMouse) state.down = false end
    circle.BackgroundTransparency = 0.55
    dot.BackgroundColor3 = THEME.accent2
    toggleBtn.Text = v and "AUTO CLICK: ON" or "AUTO CLICK: OFF"
    TweenService:Create(toggleBtn, T_FAST, {
        BackgroundColor3 = v and THEME.accent or THEME.row,
        TextColor3 = v and WHITE or THEME.subtext,
    }):Play()
end

toggleBtn.MouseButton1Click:Connect(function() setRunning(not state.running) end)
minusBtn.MouseButton1Click:Connect(function() setCps(state.cps - 1) end)
plusBtn.MouseButton1Click:Connect(function() setCps(state.cps + 1) end)
cpsBox.FocusLost:Connect(function() setCps(cpsBox.Text) end)

-- ===================== DRAG (mouse + touch) =====================
local drags = {}
local function makeDrag(handle, opts)
    local d = {opts = opts}
    handle.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
        if opts.canStart and not opts.canStart() then return end
        d.input, d.from, d.data = input, input.Position, opts.onStart()
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End and d.input == input then
                d.input = nil
                if opts.onEnd then opts.onEnd() end
            end
        end)
    end)
    drags[#drags + 1] = d
end
local dragConn = UserInputService.InputChanged:Connect(function(input)
    for _, d in ipairs(drags) do
        if d.input and (input == d.input or input.UserInputType == Enum.UserInputType.MouseMovement) then
            local delta = input.Position - d.from
            d.opts.onMove(d.data, Vector2.new(delta.X, delta.Y))
        end
    end
end)

makeDrag(circle, {
    canStart = function() return not state.running end,
    onStart = function() return clampPos(targetPos) end,
    onMove = function(origin, delta) targetPos = origin + delta applyCircle() end,
    onEnd = function() targetPos = clampPos(targetPos) applyCircle() end,
})

makeDrag(topbar, {
    onStart = function() return main.Position end,
    onMove = function(origin, delta)
        main.Position = UDim2.fromOffset(origin.X.Offset + delta.X, origin.Y.Offset + delta.Y)
    end,
})

-- window Roblox di-resize / floating: circle tetap di posisi yang diset
local camConn
local function hookCamera()
    local cam = workspace.CurrentCamera
    if not cam then return end
    if camConn then camConn:Disconnect() end
    camConn = cam:GetPropertyChangedSignal("ViewportSize"):Connect(applyCircle)
end
hookCamera()
local camSwap = workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function() hookCamera() applyCircle() end)

